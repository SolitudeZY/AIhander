{
  "name": "smart-emergency",
  "version": "1.0.0",
  "description": "fs smart emergency api",
  "main": "server.js",
  "scripts": {
    "check:runtime": "node test/runtime-compat-smoke.cjs",
    "start:agent": "node start-agent.js -p 4700 -f http://localhost:4700",
    "test": "set DEBUG=true&&\"node_modules/.bin/mocha\" --harmony --reporter spec app/test/*.test.js",
    "start": "set NODE_ENV=development&&node server -p 4700 -g postgres://USER:PASSWORD@127.0.0.1:5432/postgres -f http://localhost:4700",
    "start:linux": "export NODE_ENV=development&&node server -p 4000 -g postgres://USER:PASSWORD@127.0.0.1:5432/postgres",
    "automate": "sequelize-automate -c sequelize-automate.config.js"
  },
  "author": "",
  "license": "MIT",
  "repository": {},
  "dependencies": {
    "@alicloud/pop-core": "^1.7.12",
    "@fs/attachment": "^1.1.1",
    "args": "^3.0.7",
    "better-xlsx": "^0.7.6",
    "busboy": "0.3.1",
    "clickhouse": "^2.6.0",
    "crypto-js": "^4.0.0",
    "elasticsearch": "^13.3.1",
    "exceljs": "^3.10.0",
    "file-saver": "^2.0.2",
    "fs-web-server-scaffold": "^2.0.2",
    "ioredis": "^5.0.4",
    "kafka-node": "^5.0.0",
    "koa-convert": "^1.2.0",
    "koa-proxy": "^0.9.0",
    "moment": "^2.24.0",
    "mqtt": "^4.3.7",
    "node-schedule": "^2.1.0",
    "nodemailer": "^6.7.7",
    "path": "^0.12.7",
    "path-to-regexp": "^3.0.0",
    "pg": "^7.9.0",
    "redis": "^3.1.2",
    "request": "^2.88.2",
    "qiniu": "^7.15.2",
    "sequelize-automate-freesun": "^1.2.2",
    "superagent": "^3.5.2",
    "tmp": "0.2.1",
    "ws": "^1.1.5",
    "uuid": "^3.3.2",
    "is-arrayish": "0.3.2",
    "debug": "4.4.0"
  },
  "devDependencies": {
    "mocha": "^6.0.2"
  }
}
