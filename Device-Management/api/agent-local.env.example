# Copy to a private local file or set these variables in PowerShell.
# Do not commit the copy containing credentials.
NODE_ENV=development
EDGE_AGENT_LOCAL=true
POMS_DB=postgres://USER:PASSWORD@127.0.0.1:5432/postgres
IOTA_REDIS_SERVER_HOST=localhost
IOTA_REDIS_SERVER_PORT=6379
EDGE_AGENT_PUBLIC_URL=http://YOUR_HOST_IP:4700
EDGE_AGENT_DATA_DIR=./data/edge-agent
EDGE_AGENT_FILE_STORAGE=qiniu
ANXINCLOUD_QINIU_DOMAIN_QNDMN_RESOURCE=http://test.resources.anxinyun.cn
ANXINCLOUD_QINIU_BUCKET_RESOURCE=anxinyun-test
ANXINCLOUD_QINIU_ACCESSKEY=REPLACE_WITH_TEST_AK
ANXINCLOUD_QINIU_SECRETKEY=REPLACE_WITH_TEST_SK
EDGE_AGENT_QINIU_DOWNLOAD_TTL_SECONDS=7200
# Optional legacy firmware service; not required for RK3576/Agent model management.
# API_CRAW_URL=http://YOUR_FIRMWARE_SERVICE/v1
